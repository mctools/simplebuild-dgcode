#!/usr/bin/env python3

#Simulation used by testmcplstatsums: the particles of an MCPL file in an empty
#world (use --mcpl="grabsrc to FILE" to capture them).

import G4StdGeometries.GeoEmptyWorld as Geo
geo = Geo.create()
geo.material = "Vacuum"
geo.dimension_cm = 200

import G4MCPLPlugins.MCPLGen as Gen
gen = Gen.create()

import G4Launcher
g4 = G4Launcher(geo,gen)
g4.setPhysicsList("PL_Empty")
g4.setOutput("none")
g4.go()
